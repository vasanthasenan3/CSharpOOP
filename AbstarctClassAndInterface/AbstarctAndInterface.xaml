<Window x:Class="OopPrac2.OopPractice"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OopPrac2"
        mc:Ignorable="d"
        Title="OopPractice" Height="450" Width="800">
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
        <Button  Width="100" Background="Black" Foreground="White" Click="Button_Click" Height="100" Content="FullTime Salary"></Button>
        <Button  Width="100" Background="Black" Foreground="White" Click="Button_Click_1" Height="100" Content="Parttime Salary"></Button>
        <Button  Width="100" Background="Black" Foreground="White" Click="Button_Click_2" Height="100" Content="Upi Payment"></Button>
        <Button  Width="100" Background="Black" Foreground="White" Click="Button_Click_3" Height="100" Content="Card Payment"></Button>
    </StackPanel>
</Window>
