<Window x:Class="OopPrac2.inherits"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OopPrac2"
        mc:Ignorable="d"
        Title="inherits" Height="450" Background="LightSeaGreen" Width="800">

    <ScrollViewer VerticalScrollBarVisibility="Auto">

        <Grid Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>


            <!-- Title -->
            <TextBlock Grid.Row="0"
                       Text="Inheritance Example"
                       FontSize="28"
                       FontWeight="Bold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,30"/>


            <!-- Parent Heading -->
            <TextBlock Grid.Row="1"
                       Text="Employee Details (Parent)"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>


            <!-- Name -->
            <StackPanel Grid.Row="2"
                        Margin="0,0,0,12">

                <TextBlock Text="Name"
                           FontSize="14"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="txtName"
                         Height="35"
                         FontSize="14"
                         Padding="8"/>
            </StackPanel>


            <!-- Email -->
            <StackPanel Grid.Row="3"
                        Margin="0,0,0,25">

                <TextBlock Text="Email"
                           FontSize="14"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="txtEmail"
                         Height="35"
                         FontSize="14"
                         Padding="8"/>
            </StackPanel>


            <!-- Child Heading -->
            <TextBlock Grid.Row="4"
                       Text="Manager Details (Child)"
                       FontSize="20"
                       FontWeight="Bold"
                       Margin="0,0,0,10"/>


            <!-- Manager ID -->
            <StackPanel Grid.Row="5"
                        Margin="0,0,0,12">

                <TextBlock Text="Manager ID"
                           FontSize="14"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="txtManagerId"
                         Height="35"
                         FontSize="14"
                         Padding="8"/>
            </StackPanel>


            <!-- Department -->
            <StackPanel Grid.Row="6"
                        Margin="0,0,0,20">

                <TextBlock Text="Department"
                           FontSize="14"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="txtDepartment"
                         Height="35"
                         FontSize="14"
                         Padding="8"/>
            </StackPanel>


            <!-- Button + Output -->
            <StackPanel Grid.Row="7">

                <Button Content="Show Details"
                        x:Name="btnShow"
                   Click="btnShow_Click_1"
                        Height="40"
                        FontSize="16"
                        Background="#1976D2"
                        Foreground="White"
                        BorderThickness="0"
                      
                        Margin="0,0,0,25"/>

                <TextBlock Text="Output"
                           FontSize="20"
                           FontWeight="Bold"
                           Margin="0,0,0,10"/>

                <TextBox x:Name="txtOutput"
                         Height="100"
                         FontSize="15"
                         Padding="10"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"/>

            </StackPanel>

        </Grid>

    </ScrollViewer>
</Window>

