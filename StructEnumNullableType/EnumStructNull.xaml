<Window x:Class="OopPrac2.EmployeeAttendtance"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OopPrac2"
        mc:Ignorable="d"
        Title="C# Practice"
        Height="500"
        Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FB">

    <Grid Margin="30">

        <Border Background="White"
                CornerRadius="20"
                Padding="30">

            <StackPanel>

                <!-- Title -->
                <TextBlock Text="C# Practice"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#4F46E5"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Struct • Enum • Nullable"
                           FontSize="14"
                           Foreground="Gray"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,25"/>


                <!-- Name -->
                <TextBlock Text="Name"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="txtName"
                         Height="38"
                         Padding="10"
                         Margin="0,0,0,15"/>


                <!-- Age -->
                <TextBlock Text="Age (Optional)"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="txtAge"
                         Height="38"
                         Padding="10"
                         Margin="0,0,0,15"/>


                <!-- Status -->
                <TextBlock Text="Status"
                           FontWeight="SemiBold"
                           Margin="0,0,0,5"/>

                <ComboBox x:Name="cmbStatus"
                          Height="38"
                          Padding="8"
                          Margin="0,0,0,25">

                    <ComboBoxItem Content="Active"/>
                    <ComboBoxItem Content="Inactive"/>
                    <ComboBoxItem Content="On Leave"/>

                </ComboBox>


                <!-- Button -->
                <Button Content="Save"
                        x:Name="btnSave"
                        Height="45"
                        Width="140"
                        Background="#4F46E5"
                        Foreground="White"
                        FontSize="16"
                        FontWeight="Bold"
                        BorderThickness="0"
                        HorizontalAlignment="Center"
                        Click="btnSave_Click"
                        />


                <!-- Result -->
                <Border Background="#EEF2FF"
                        CornerRadius="10"
                        Padding="15"
                        Margin="0,25,0,0">

                    <TextBlock x:Name="txtResult"
                               Text="Result will appear here"
                               FontSize="15"
                               Foreground="#3730A3"
                               TextAlignment="Center"/>

                </Border>

            </StackPanel>

        </Border>

    </Grid>

</Window>


