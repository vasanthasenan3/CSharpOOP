<Window x:Class="ShopDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShopDemo"
        xmlns:vm="clr-namespace:ShopDemo.Viewmodel;assembly=ShopDemo.Viewmodel"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <vm:Userview></vm:Userview>
    </Window.DataContext>
    <StackPanel>
        <Label Content="Name"></Label>
        <TextBox Name="txtname" Text="{Binding UserList.Name}"></TextBox>
        <Label Content="Adress"></Label>
        <TextBox Name="txtad" Text="{Binding UserList.Address}"></TextBox>
        <Label Content="Dob"></Label>
        <TextBox Name="txtdob" Text="{Binding UserList.DOB}"></TextBox>
        <Button Content="save" Command="{Binding ClickHere}" ></Button>
        <Button Content="Clear" Command="{Binding ClearClick}" ></Button>
    </StackPanel>
</Window>
