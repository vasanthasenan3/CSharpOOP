<Window x:Class="OopPrac2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:OopPrac2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

        <!-- REF Button -->
        <Button Content="REF"
            Width="150"
              
            Height="60"
            Margin="10"
            FontSize="20"
            FontWeight="Bold"
            Foreground="White"
            Background="#6C5CE7"
            BorderThickness="0"
            Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="15"/>
                </Style>
            </Button.Resources>
        </Button>

        <!-- IN Button -->
        <Button Content="IN"
            Width="150"
            Height="60"
               
            Margin="10"
            FontSize="20"
            FontWeight="Bold"
            Foreground="White"
            Background="#00B894"
            BorderThickness="0"
            Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="15"/>
                </Style>
            </Button.Resources>
        </Button>

        <!-- OUT Button -->
        <Button Content="OUT"
            Width="150"
            
            Height="60"
            Margin="10"
            FontSize="20"
            FontWeight="Bold"
            Foreground="White"
            Background="#E17055"
            BorderThickness="0"
            Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="15"/>
                </Style>
            </Button.Resources>
        </Button>

    </StackPanel>
</Window>
